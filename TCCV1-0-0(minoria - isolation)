import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.ensemble import IsolationForest
import numpy as np

# 1. Carregamento da base de dados (Kaggle HR Analytics)
try:
    df = pd.read_csv('HR_comma_sep.csv')
except FileNotFoundError:
    print("Erro: O ficheiro 'HR_comma_sep.csv' nao foi encontrado.")
    exit()

# 2. Separacao da variavel alvo e tratamento de dados
y = df['left']

le = LabelEncoder()
for col in df.select_dtypes(include=['object']).columns:
    df[col] = le.fit_transform(df[col])

X = df.drop(columns=['left'])

# 3. Segregacao das classes
X_maioria = X[y == 0]  # Retencao (Quem Fica)
X_minoria = X[y == 1]  # Turnover (Quem Sai)

# 4. INVERSAO DA METODOLOGIA: Treino apenas com a MINORIA
# Vamos separar 80% de quem saiu para treinar, e 20% para validar
X_train_min, X_val_min = train_test_split(X_minoria, test_size=0.2, random_state=42)

# 5. Normalizacao baseada no padrao da minoria
scaler = StandardScaler()
X_train_min_scaled = scaler.fit_transform(X_train_min)
X_val_min_scaled = scaler.transform(X_val_min)
X_maioria_scaled = scaler.transform(X_maioria)

# 6. Treinamento do modelo Isolation Forest EXCLUSIVAMENTE com quem saiu
modelo_iso = IsolationForest(random_state=42, contamination='auto')
modelo_iso.fit(X_train_min_scaled)

# 7. Calculo dos Scores de Anomalia
# Agora, queremos ver se a Maioria vai ser considerada "anomala" em relacao ao Turnover
score_minoria = -modelo_iso.score_samples(X_val_min_scaled)
score_maioria = -modelo_iso.score_samples(X_maioria_scaled)

desvio_medio_minoria = np.mean(score_minoria)
desvio_medio_maioria = np.mean(score_maioria)

# 8. Emissao dos resultados cientificos no terminal
print("\n--- RESULTADOS DO TESTE INVERSO (TREINO COM A MINORIA) ---")
print(f"Registros utilizados no treino (Turnover): {X_train_min.shape[0]}")
print(f"Desvio Medio - Base de Validacao (Turnover): {desvio_medio_minoria:.4f}")
print(f"Desvio Medio - Base de Teste (Retencao): {desvio_medio_maioria:.4f}")